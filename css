/* src/pages/MainPage.css */
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&display=swap');

.qam-root {
  background: #05080f;
  min-height: 100vh;
  color: #a0c4ff;
  font-family: 'JetBrains Mono', monospace;
  overflow: hidden;
  position: relative;
}

.bg-grid {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.2;
  background-image: 
    linear-gradient(rgba(13,43,74,0.3) 1px, transparent 1px),
    linear-gradient(90deg, rgba(13,43,74,0.3) 1px, transparent 1px);
  background-size: 40px 40px;
}

/* Top Bar */
.top-bar {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 24px;
  border-bottom: 1px solid #0a1f3a;
}

.logo-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pulse-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #00f0ff;
  box-shadow: 0 0 12px #00f0ff, 0 0 24px #00f0ff;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.logo-text {
  font-size: 12px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #4a90d9;
}

.version-tag {
  font-size: 10px;
  color: #1a6b3a;
  margin-left: 8px;
}

.status-group {
  display: flex;
  gap: 20px;
  font-size: 11px;
  letter-spacing: 1px;
}

.status-online { color: #00f0ff; }
.status-secure { color: #1a6b3a; }
.clock { color: #4a90d9; }

/* Main Grid */
.main-grid {
  position: relative;
  z-index: 10;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto auto;
  gap: 16px;
  padding: 20px;
  max-width: 1400px;
  margin: 0 auto;
}

@media (max-width: 768px) {
  .main-grid {
    grid-template-columns: 1fr;
  }
}

/* Panels */
.panel {
  background: rgba(5,12,25,0.85);
  border: 1px solid #0d2b4a;
  border-radius: 8px;
  padding: 16px;
  backdrop-filter: blur(4px);
  transition: all 0.3s ease;
}

.panel:hover {
  border-color: #00f0ff;
  box-shadow: 0 0 20px rgba(0,240,255,0.05);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.panel-title {
  font-size: 10px;
  letter-spacing: 2px;
  color: #4a90d9;
  text-transform: uppercase;
}

.status-badge {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 3px;
}

.status-badge.ready { color: #1a6b3a; }
.status-badge.processing { color: #00f0ff; }
.status-badge.complete { color: #1a6b3a; }
.status-badge.error { color: #ff4444; }

/* Inputs */
.input-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}

.input-row {
  display: flex;
  gap: 8px;
  align-items: center;
}

.input-row label {
  font-size: 10px;
  color: #4a90d9;
  width: 90px;
}

.crypto-input {
  flex: 1;
  background: rgba(0,240,255,0.05);
  border: 1px solid #0d2b4a;
  border-radius: 4px;
  padding: 4px 8px;
  color: #00f0ff;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  outline: none;
  transition: border-color 0.3s;
}

.crypto-input:focus {
  border-color: #00f0ff;
}

.crypto-input.readonly {
  background: rgba(0,240,255,0.03);
  color: #4a90d9;
}

.unit {
  font-size: 10px;
  color: #4a90d9;
}

/* Tags */
.tag-group {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.tag {
  background: rgba(0,240,255,0.08);
  border: 1px solid rgba(0,240,255,0.2);
  padding: 3px 8px;
  border-radius: 3px;
  font-size: 9px;
  color: #00f0ff;
  transition: background 0.3s;
  cursor: default;
}

.tag:hover {
  background: rgba(0,240,255,0.15);
}

/* Generate Button */
.generate-btn {
  width: 100%;
  background: linear-gradient(90deg, rgba(0,240,255,0.15), rgba(74,144,217,0.15));
  border: 1px solid #00f0ff;
  color: #00f0ff;
  padding: 8px 16px;
  border-radius: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 1px;
  cursor: pointer;
  transition: all 0.3s;
}

.generate-btn:hover {
  background: linear-gradient(90deg, rgba(0,240,255,0.25), rgba(74,144,217,0.25));
  box-shadow: 0 0 15px rgba(0,240,255,0.2);
}

.generate-btn:active {
  transform: scale(0.98);
}

.generate-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Preview Panel */
.preview-panel {
  position: relative;
  overflow: hidden;
  min-height: 200px;
}

.holo-canvas {
  width: 100%;
  height: 160px;
  border-radius: 4px;
}

.preview-signature {
  position: absolute;
  bottom: 12px;
  right: 16px;
  font-size: 9px;
  color: #4a90d9;
  opacity: 0.6;
}

/* Metrics */
.metrics-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.metric-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.metric-row > span:first-child {
  font-size: 11px;
  color: #4a90d9;
}

.metric-bar-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.metric-bar-bg {
  width: 80px;
  height: 3px;
  background: #0d2b4a;
  border-radius: 2px;
  overflow: hidden;
}

.metric-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #00f0ff, #4a90d9);
  border-radius: 2px;
  transition: width 0.5s ease;
}

.metric-value {
  font-size: 11px;
  color: #00f0ff;
  width: 28px;
  text-align: right;
}

/* Audit Text */
.audit-text {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #0d2b4a;
  font-size: 10px;
  color: #4a90d9;
  line-height: 1.6;
  min-height: 40px;
}

.audit-text .highlight {
  color: #00f0ff;
}

.audit-text .label {
  color: #4a90d9;
}

.audit-text .confidence {
  color: #1a6b3a;
  font-size: 9px;
}

/* Interpretation Panel */
.interpretation-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 200px;
}

.interpretation-text {
  margin-top: 8px;
  font-size: 9px;
  color: #4a90d9;
  letter-spacing: 1px;
  text-align: center;
  line-height: 1.5;
  max-width: 200px;
}

.interpretation-text .highlight {
  color: #00f0ff;
}

.interpretation-text .label {
  color: #4a90d9;
}

.interpretation-text .confidence {
  color: #1a6b3a;
  font-size: 9px;
}

/* Metrics Grid */
.metrics-grid {
  display: flex;
  gap: 16px;
  align-items: center;
}

.metrics-left {
  flex: 1;
}

.big-metric {
  font-size: 28px;
  color: #00f0ff;
  font-weight: 300;
  text-shadow: 0 0 16px rgba(0,240,255,0.3);
}

.medium-metric {
  margin-top: 12px;
  font-size: 22px;
  color: #4a90d9;
  font-weight: 300;
}

.medium-metric.green {
  color: #1a6b3a;
}

.metric-label {
  font-size: 9px;
  color: #4a90d9;
  margin-top: 2px;
}

.metrics-divider {
  width: 1px;
  height: 120px;
  background: linear-gradient(180deg, transparent, #0d2b4a, transparent);
}

.metrics-right {
  flex: 1;
}

.spectrum-label {
  font-size: 10px;
  color: #4a90d9;
  margin-bottom: 6px;
  letter-spacing: 1px;
}

.spectrum-bars {
  display: flex;
  align-items: end;
  gap: 3px;
  height: 80px;
}

.spectrum-bar {
  width: 4px;
  background: linear-gradient(180deg, #00f0ff, #4a90d9);
  border-radius: 1px;
  opacity: 0.6;
  transition: height 0.3s ease;
}

/* Report */
.report-header {
  display: flex;
  align-items: center;
  gap: 20px;
}

.entropy-big {
  font-size: 42px;
  color: #00f0ff;
  font-weight: 700;
  text-shadow: 0 0 30px rgba(0,240,255,0.5);
  letter-spacing: -2px;
}

.entropy-chart {
  flex: 1;
}

.chart-label {
  font-size: 9px;
  color: #4a90d9;
  margin-bottom: 4px;
  letter-spacing: 1px;
}

.sparkline {
  height: 60px;
  width: 100%;
}

.report-body {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #0d2b4a;
  font-size: 10px;
  color: #4a90d9;
  line-height: 1.6;
  min-height: 60px;
}

.report-body .highlight {
  color: #00f0ff;
}

.report-body .label {
  color: #4a90d9;
}

.hash-footer {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid #0d2b4a;
}

.hash-label {
  font-size: 9px;
  color: #4a90d9;
  letter-spacing: 1px;
  margin-bottom: 4px;
}

.hash-value {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: #00f0ff;
  opacity: 0.7;
  word-break: break-all;
}

/* Full Width Sections */
.fullwidth-section {
  position: relative;
  z-index: 10;
  padding: 0 20px 20px;
  max-width: 1400px;
  margin: 0 auto;
}

.network-canvas {
  width: 100%;
  height: 140px;
  border-radius: 4px;
}

/* Report Meta */
.report-meta {
  display: flex;
  gap: 12px;
  align-items: center;
}

.report-meta span {
  font-size: 10px;
  color: #4a90d9;
}

/* Comprehensive Body */
.comprehensive-body {
  font-size: 11px;
  color: #a0c4ff;
  line-height: 1.7;
  min-height: 80px;
  white-space: pre-wrap;
}

/* Footer */
.footer {
  position: relative;
  z-index: 10;
  padding: 0 20px 20px;
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 9px;
  letter-spacing: 1px;
  color: #4a90d9;
  opacity: 0.5;
}
